// The half-resolution layer pass's depth reduction (renderer.cpp,
// flush_layers): the native rectangle with the four full-resolution texel
// centres each target pixel covers as separate coordinates, so the fragment
// program's reads are non-dependent. `offset` is half a full-resolution texel.
void main(float vertex_id : TEXCOORD14,
          uniform float4 region, uniform float depth, uniform float4 offset,
          out float4 position : POSITION, out float2 uv0 : TEXCOORD0, out float2 uv1 : TEXCOORD1,
          out float2 uv2 : TEXCOORD2, out float2 uv3 : TEXCOORD3)
{
    float2 q = float2(vertex_id == 1.0 || vertex_id == 3.0 ? 1.0 : 0.0,
                      vertex_id >= 2.0 ? 1.0 : 0.0);
    position = float4(region.xy + q * region.zw, depth, 1.0);
    uv0 = q - offset.xy;
    uv1 = q + float2(offset.x, -offset.y);
    uv2 = q + float2(-offset.x, offset.y);
    uv3 = q + offset.xy;
}
