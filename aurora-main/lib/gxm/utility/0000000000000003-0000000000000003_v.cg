// Validate the same mapped BUFFER bindings and U16 streams as recorded GX draws.
float4 colors[3] : BUFFER[0];
float4 positions[4] : BUFFER[1];
float depths[1] : BUFFER[2];
void main(float vertex_id : TEXCOORD14, float instance_id : TEXCOORD15,
          out float4 position : POSITION, out float4 color : TEXCOORD0)
{
    position = positions[int(vertex_id)];
    position.x = position.x * 0.5 + instance_id - 0.5;
    position.z = depths[0];
    color = colors[int(instance_id)];
}
