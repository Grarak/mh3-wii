// The half-resolution layer pass's depth (renderer.cpp, flush_layers): each
// target pixel takes the nearest of the four full-resolution depths it covers
// (read at the vertex program's coordinates: non-dependent), so the layers
// stay behind every surface in front of them; its colour starts transparent.
void main(float2 uv0 : TEXCOORD0, float2 uv1 : TEXCOORD1, float2 uv2 : TEXCOORD2, float2 uv3 : TEXCOORD3,
          uniform sampler2D source : TEXUNIT0, out float4 color : COLOR, out float depth : DEPTH)
{
    float a = tex2D<float>(source, uv0);
    float b = tex2D<float>(source, uv1);
    float c = tex2D<float>(source, uv2);
    float d = tex2D<float>(source, uv3);
    depth = min(min(a, b), min(c, d));
    color = float4(0.0, 0.0, 0.0, 0.0);
}
