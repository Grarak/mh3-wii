find_package(Python3 REQUIRED COMPONENTS Interpreter)
# Build a local source overlay; never modify the shared Aurora checkout.
get_target_property(mh3_gx_source_dir aurora_gx SOURCE_DIR)
set(mh3_common_original "${mh3_gx_source_dir}/lib/gfx/common.cpp")
file(READ "${mh3_common_original}" mh3_common_text)
set(mh3_begin_original "bool begin_frame() { return begin_frame_impl(true); }")
string(FIND "${mh3_common_text}" "${mh3_begin_original}" mh3_begin_offset)
if(mh3_begin_offset EQUAL -1)
  message(FATAL_ERROR "Aurora EFB preservation overlay no longer matches begin_frame")
endif()
string(REPLACE "${mh3_begin_original}"
  "static bool mh3_preserve_next_efb = false;\nvoid preserve_next_efb_frame() { mh3_preserve_next_efb = true; }\nbool begin_frame() { const bool clear = !mh3_preserve_next_efb; mh3_preserve_next_efb = false; return begin_frame_impl(clear); }"
  mh3_common_text "${mh3_common_text}")
set(mh3_common_overlay "${CMAKE_BINARY_DIR}/mh3-aurora/common.cpp")
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/mh3-aurora")
file(WRITE "${mh3_common_overlay}.in" "${mh3_common_text}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${CMAKE_CURRENT_LIST_DIR}/patch_aurora_shared_buffers.py")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/patch_aurora_shared_buffers.py"
  common "${mh3_common_overlay}.in" COMMAND_ERROR_IS_FATAL ANY)
configure_file("${mh3_common_overlay}.in" "${mh3_common_overlay}" COPYONLY)
get_target_property(mh3_gx_sources aurora_gx SOURCES)
set(mh3_gx_patched_sources)
set(mh3_replaced_common FALSE)
foreach(mh3_source IN LISTS mh3_gx_sources)
  if(NOT IS_ABSOLUTE "${mh3_source}" AND NOT mh3_source MATCHES "^\\$<")
    set(mh3_source "${mh3_gx_source_dir}/${mh3_source}")
  endif()
  if(mh3_source STREQUAL mh3_common_original)
    set(mh3_source "${mh3_common_overlay}")
    set(mh3_replaced_common TRUE)
  endif()
  list(APPEND mh3_gx_patched_sources "${mh3_source}")
endforeach()
if(NOT mh3_replaced_common)
  message(FATAL_ERROR "Aurora common.cpp target source was not found")
endif()
set_property(TARGET aurora_gx PROPERTY SOURCES "${mh3_gx_patched_sources}")
set_source_files_properties("${mh3_common_overlay}" TARGET_DIRECTORY aurora_gx
  PROPERTIES INCLUDE_DIRECTORIES "${mh3_gx_source_dir}/lib/gfx")

# Keep the fence in Aurora's translation unit so it shares its worker/submit locks.
get_target_property(mh3_core_source_dir aurora_core SOURCE_DIR)
set(mh3_core_original "${mh3_core_source_dir}/lib/aurora.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${mh3_common_original}" "${mh3_core_original}"
  "${CMAKE_CURRENT_LIST_DIR}/aurora-flush-draws.inc")
file(READ "${mh3_core_original}" mh3_core_text)
file(READ "${CMAKE_CURRENT_LIST_DIR}/aurora-flush-draws.inc" mh3_flush_extension)
set(mh3_core_overlay "${CMAKE_BINARY_DIR}/mh3-aurora/aurora.cpp")
file(WRITE "${mh3_core_overlay}.in" "${mh3_core_text}\n${mh3_flush_extension}")
find_package(Python3 REQUIRED COMPONENTS Interpreter)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${CMAKE_CURRENT_LIST_DIR}/patch_aurora_async.py")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/patch_aurora_async.py"
  "${mh3_core_overlay}.in" COMMAND_ERROR_IS_FATAL ANY)
configure_file("${mh3_core_overlay}.in" "${mh3_core_overlay}" COPYONLY)
get_target_property(mh3_core_sources aurora_core SOURCES)
set(mh3_core_patched_sources)
set(mh3_replaced_core FALSE)
foreach(mh3_source IN LISTS mh3_core_sources)
  if(NOT IS_ABSOLUTE "${mh3_source}" AND NOT mh3_source MATCHES "^\\$<")
    set(mh3_source "${mh3_core_source_dir}/${mh3_source}")
  endif()
  if(mh3_source STREQUAL mh3_core_original)
    set(mh3_source "${mh3_core_overlay}")
    set(mh3_replaced_core TRUE)
  endif()
  list(APPEND mh3_core_patched_sources "${mh3_source}")
endforeach()
if(NOT mh3_replaced_core)
  message(FATAL_ERROR "Aurora aurora.cpp target source was not found")
endif()
set_property(TARGET aurora_core PROPERTY SOURCES "${mh3_core_patched_sources}")
set_source_files_properties("${mh3_core_overlay}" TARGET_DIRECTORY aurora_core
  PROPERTIES INCLUDE_DIRECTORIES "${mh3_core_source_dir}/lib")

# GX's viewport origins and scissor coordinates share a 342-pixel hardware
# bias. Keep Aurora's native GX encoder and FIFO decoder in the same domain;
# subtracting 340 shifts guest rendering and repeated EFB effects by two pixels.
foreach(mh3_viewport_relative IN ITEMS lib/gx/command_processor.cpp lib/dolphin/gx/GXTransform.cpp)
  set(mh3_viewport_original "${mh3_gx_source_dir}/${mh3_viewport_relative}")
  file(READ "${mh3_viewport_original}" mh3_viewport_text)
  string(REGEX MATCHALL "340\\.0f" mh3_viewport_biases "${mh3_viewport_text}")
  list(LENGTH mh3_viewport_biases mh3_viewport_bias_count)
  if(NOT mh3_viewport_bias_count EQUAL 2)
    message(FATAL_ERROR "Aurora viewport bias overlay no longer matches ${mh3_viewport_relative}")
  endif()
  string(REPLACE "340.0f" "342.0f" mh3_viewport_text "${mh3_viewport_text}")
  set(mh3_viewport_overlay "${CMAKE_BINARY_DIR}/mh3-aurora/${mh3_viewport_relative}")
  get_filename_component(mh3_viewport_overlay_dir "${mh3_viewport_overlay}" DIRECTORY)
  get_filename_component(mh3_viewport_original_dir "${mh3_viewport_original}" DIRECTORY)
  file(MAKE_DIRECTORY "${mh3_viewport_overlay_dir}")
  file(WRITE "${mh3_viewport_overlay}.in" "${mh3_viewport_text}")
  configure_file("${mh3_viewport_overlay}.in" "${mh3_viewport_overlay}" COPYONLY)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${mh3_viewport_original}")
  get_target_property(mh3_viewport_sources aurora_gx SOURCES)
  list(FIND mh3_viewport_sources "${mh3_viewport_original}" mh3_viewport_source_index)
  if(mh3_viewport_source_index EQUAL -1)
    message(FATAL_ERROR "Aurora viewport source not found: ${mh3_viewport_original}")
  endif()
  list(REMOVE_AT mh3_viewport_sources ${mh3_viewport_source_index})
  list(APPEND mh3_viewport_sources "${mh3_viewport_overlay}")
  set_property(TARGET aurora_gx PROPERTY SOURCES "${mh3_viewport_sources}")
  set_source_files_properties("${mh3_viewport_overlay}" TARGET_DIRECTORY aurora_gx
    PROPERTIES INCLUDE_DIRECTORIES "${mh3_viewport_original_dir}")
endforeach()

# Shared-buffer feature request and offset-aware consumers.
foreach(mh3_shared_spec IN ITEMS "aurora_core|lib/webgpu/gpu.cpp|gpu"
    "aurora_gx|lib/gx/pipeline.cpp|pipeline" "aurora_gx|lib/gfx/tex_copy_conv.cpp|tex_copy")
  string(REPLACE "|" ";" mh3_shared_parts "${mh3_shared_spec}")
  list(GET mh3_shared_parts 0 mh3_shared_target)
  list(GET mh3_shared_parts 1 mh3_shared_relative)
  list(GET mh3_shared_parts 2 mh3_shared_kind)
  set(mh3_shared_original "${mh3_gx_source_dir}/${mh3_shared_relative}")
  set(mh3_shared_overlay "${CMAKE_BINARY_DIR}/mh3-aurora/${mh3_shared_relative}")
  get_filename_component(mh3_shared_dir "${mh3_shared_overlay}" DIRECTORY)
  get_filename_component(mh3_shared_include "${mh3_shared_original}" DIRECTORY)
  file(MAKE_DIRECTORY "${mh3_shared_dir}")
  configure_file("${mh3_shared_original}" "${mh3_shared_overlay}.in" COPYONLY)
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/patch_aurora_shared_buffers.py"
    "${mh3_shared_kind}" "${mh3_shared_overlay}.in" COMMAND_ERROR_IS_FATAL ANY)
  configure_file("${mh3_shared_overlay}.in" "${mh3_shared_overlay}" COPYONLY)
  get_target_property(mh3_shared_sources ${mh3_shared_target} SOURCES)
  list(FIND mh3_shared_sources "${mh3_shared_original}" mh3_shared_index)
  if(mh3_shared_index EQUAL -1)
    message(FATAL_ERROR "Shared-buffer source not found: ${mh3_shared_original}")
  endif()
  list(REMOVE_AT mh3_shared_sources ${mh3_shared_index})
  list(APPEND mh3_shared_sources "${mh3_shared_overlay}")
  set_property(TARGET ${mh3_shared_target} PROPERTY SOURCES "${mh3_shared_sources}")
  set_source_files_properties("${mh3_shared_overlay}" TARGET_DIRECTORY ${mh3_shared_target}
    PROPERTIES INCLUDE_DIRECTORIES "${mh3_shared_include}")
  if(mh3_shared_kind STREQUAL "gpu" AND MH3_ENABLE_GPU_VALIDATION)
    set_property(SOURCE "${mh3_shared_overlay}" TARGET_DIRECTORY ${mh3_shared_target}
      APPEND PROPERTY COMPILE_DEFINITIONS MH3_ENABLE_GPU_VALIDATION=1)
  endif()
endforeach()
