# Build a local source overlay; never modify the shared Aurora checkout.
get_target_property(mh3_gx_source_dir aurora_gx SOURCE_DIR)
set(mh3_common_original "${mh3_gx_source_dir}/lib/gfx/common.cpp")
file(READ "${mh3_common_original}" mh3_common_text)
set(mh3_begin_original "bool begin_frame() { return begin_frame_impl(true); }")
string(FIND "${mh3_common_text}" "${mh3_begin_original}" mh3_begin_offset)
if(mh3_begin_offset EQUAL -1)
  message(FATAL_ERROR "Aurora EFB preservation overlay no longer matches begin_frame")
endif()
string(REPLACE "${mh3_begin_original}"
  "static bool mh3_preserve_next_efb = false;\nvoid preserve_next_efb_frame() { mh3_preserve_next_efb = true; }\nbool begin_frame() { const bool clear = !mh3_preserve_next_efb; mh3_preserve_next_efb = false; return begin_frame_impl(clear); }"
  mh3_common_text "${mh3_common_text}")
set(mh3_common_overlay "${CMAKE_BINARY_DIR}/mh3-aurora/common.cpp")
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/mh3-aurora")
file(WRITE "${mh3_common_overlay}.in" "${mh3_common_text}")
configure_file("${mh3_common_overlay}.in" "${mh3_common_overlay}" COPYONLY)
get_target_property(mh3_gx_sources aurora_gx SOURCES)
set(mh3_gx_patched_sources)
set(mh3_replaced_common FALSE)
foreach(mh3_source IN LISTS mh3_gx_sources)
  if(NOT IS_ABSOLUTE "${mh3_source}" AND NOT mh3_source MATCHES "^\\$<")
    set(mh3_source "${mh3_gx_source_dir}/${mh3_source}")
  endif()
  if(mh3_source STREQUAL mh3_common_original)
    set(mh3_source "${mh3_common_overlay}")
    set(mh3_replaced_common TRUE)
  endif()
  list(APPEND mh3_gx_patched_sources "${mh3_source}")
endforeach()
if(NOT mh3_replaced_common)
  message(FATAL_ERROR "Aurora common.cpp target source was not found")
endif()
set_property(TARGET aurora_gx PROPERTY SOURCES "${mh3_gx_patched_sources}")
set_source_files_properties("${mh3_common_overlay}" TARGET_DIRECTORY aurora_gx
  PROPERTIES INCLUDE_DIRECTORIES "${mh3_gx_source_dir}/lib/gfx")
